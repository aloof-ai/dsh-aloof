{
  "name": "dsh-aloof",
  "version": "0.5.0",
  "description": "把团队的做事方式装进这台机器的 agent：从 Aloof 同步团队红线（进系统提示）和团队手册（进技能目录），管理员在网页上改一句话，这台 dsh 下一次对话就照新的来。外加 /aloof 命令和右下角那颗可拖动、带红绿灯的悬浮按钮——连的哪台 Aloof、被认成谁、下发了什么，接入令牌也能直接在那儿换。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "aloof"
  ],
  "license": "MIT",
  "author": "Aloof",
  "homepage": "https://github.com/aloof-ai/dsh-aloof#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aloof-ai/dsh-aloof.git"
  },
  "bugs": {
    "url": "https://github.com/aloof-ai/dsh-aloof/issues"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
